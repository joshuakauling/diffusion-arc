{
  "schema_version": 1,
  "generator_version": 1,
  "source": {
    "dataset": "arc-agi-2",
    "split": "training"
  },
  "palette": "greedy_rgb_maximin_v1",
  "limits": {
    "max_pairs": 6,
    "max_cells": 120,
    "max_tokens": 192
  },
  "task_splits": {
    "train": "train.json",
    "validation": "validation.json"
  },
  "views": {
    "train": {
      "task_split": "train",
      "output": "augmented_keys/train.json",
      "mode": "sampled",
      "seed": 167,
      "augmentations_per_task": 512,
      "exclude": [
        "train_original"
      ]
    },
    "train_original": {
      "task_split": "train",
      "output": "augmented_keys/train_original.json",
      "mode": "identity",
      "exclude": []
    },
    "train_unseen": {
      "task_split": "train",
      "output": "augmented_keys/train_unseen.json",
      "mode": "sampled",
      "seed": 72,
      "augmentations_per_task": 8,
      "exclude": [
        "train",
        "train_original"
      ]
    }
  }
}
